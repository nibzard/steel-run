# Steel.run Environment Configuration

# API Keys (Required)
STEEL_API_KEY=your_steel_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Security
SECRET_KEY=your_secret_key_here_should_be_long_and_random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CREDENTIAL_ENCRYPTION_KEY=generate_this_fernet_key

# Database
DATABASE_URL=sqlite+aiosqlite:///./steel_actions.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/steel_run

# Redis (Optional)
REDIS_URL=redis://localhost:6379/0

# Application Settings
ENV=development
DEBUG=true
APP_NAME=Steel.run
HOST=0.0.0.0
PORT=8000

# Steel Configuration
DEFAULT_REGION=lax
MAX_CONCURRENT_SESSIONS=10
DEFAULT_SESSION_TIMEOUT=30000
ENABLE_CAPTCHA_SOLVING=true

# Rate Limiting
RATE_LIMIT_PER_IP=100
RATE_LIMIT_PER_USER=500

# External Services
ENABLE_WEBHOOKS=true
WEBHOOK_TIMEOUT=30

# Monitoring
ENABLE_METRICS=true
LOG_LEVEL=info

# Development
RELOAD=true